{
  "repo": "C:/path/to/your-repo",
  "port": 4317,
  "sessionCwdMatch": "your-repo",
  "coordinator": "Coordinator",
  "codingAgents": {
    "Coordinator": "Coordinator",
    "Agent 1": "Agent 1",
    "Agent 2": "Agent 2",
    "my-session-name": "Agent 3"
  },
  "aliases": {
    "some-session": "A friendlier name"
  },
  "stopHour": null,
  "ticketPrefixes": ["ABC"],
  "reminders": [
    { "at": "17:55", "days": "weekdays", "text": "Wrap up: commit or park your work." }
  ],
  "standup": {
    "author": "",
    "name": "Your Name",
    "project": "Your project",
    "base": "",
    "ticketUrl": "https://app.switchboardpm.ai/stories/{id}"
  },
  "factory": {
    "collections": [
      {
        "id": "main",
        "name": "Main board",
        "kind": "switchboard",
        "project": "YOUR_PROJECT_ID",
        "tools": ["mcp__switchboard-claude__list_stories"],
        "filter": {
          "prefix": "ABC",
          "range": [100, 199],
          "extras": []
        },
        "plan": "C:/path/to/your-repo/docs/plan.md",
        "refreshMinutes": 0
      },
      {
        "id": "beta",
        "name": "A board only a browser can read",
        "kind": "agent",
        "ask": "Open https://example.com/board in the browser and read every card (id, title, column, owner).",
        "tools": ["mcp__playwright__*"],
        "refreshMinutes": 0
      }
    ],
    "me": "your-tracker-user-id",
    "chat": {
      "name": "Independent",
      "forkFrom": "",
      "model": "claude-opus-5-5",
      "mode": "brief"
    },
    "relayModel": "claude-sonnet-5-5",
    "explainModel": "claude-haiku-5-5"
  },
  "claudeDirs": [],
  "tokens": {
    "prices": {
      "claude-opus-5-5": { "input": 4, "output": 20, "cacheWrite": 5, "cacheWrite1h": 8, "cacheRead": 0.2 },
      "claude-opus-5": { "input": 5, "output": 25, "cacheWrite": 6.25, "cacheWrite1h": 10, "cacheRead": 0.5 },
      "claude-sonnet-5-5": { "input": 2, "output": 10, "cacheWrite": 2.5, "cacheWrite1h": 4, "cacheRead": 0.1 },
      "claude-fable-5-2": { "input": 8, "output": 40, "cacheWrite": 10, "cacheWrite1h": 16, "cacheRead": 0.2 },
      "claude-fable-5-1": { "input": 10, "output": 50, "cacheWrite": 12.5, "cacheWrite1h": 20, "cacheRead": 0.25 }
    }
  },
  "pipeline": {
    "qa": "QA",
    "producers": null,
    "protectedBranches": ["dev", "stage", "main", "master"],
    "maxReworks": 3,
    "planner": null,
    "security": null,
    "senior": null
  },
  "pr": {
    "enabled": false,
    "remote": "origin",
    "bases": ["dev"],
    "gh": "gh"
  }
}
